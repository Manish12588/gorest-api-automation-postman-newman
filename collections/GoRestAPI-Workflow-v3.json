{
  "info": {
    "_postman_id": "7002ec29-ba36-4fe3-8f98-4357707c8afb",
    "name": "GoRestAPI-Workflow-v3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
